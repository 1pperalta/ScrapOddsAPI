FROM node:20-alpine as build
WORKDIR /app

# Copy package files
COPY package*.json ./

# Clean install with esbuild rebuild
RUN npm cache clean --force && \
    npm install --legacy-peer-deps && \
    npm rebuild esbuild && \
    npx esbuild --version

# Copy source files
COPY . .

# Build the application
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
