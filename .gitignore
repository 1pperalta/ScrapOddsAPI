# ===========================================
# KEEP THESE FILES
# ===========================================

# Keep .gitignore itself
!.gitignore

# Keep README and documentation
!README.md
!*.md

# Keep package.json for dependency management
!package.json

# Keep requirements.txt for Python dependencies
!requirements.txt